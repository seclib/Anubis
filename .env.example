# ==============================================
# Anubis Agent V4 — Variables d'environnement
# Copier ce fichier en .env et adapter les valeurs
# ==============================================

# --- LLM ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_FALLBACK_MODEL=qwen2.5-coder:7b
OLLAMA_NUM_CTX=8192
OLLAMA_KEEP_ALIVE=1h
ORCHESTRATOR_AGENT_MODEL=qwen2.5-coder:7b
PLANNER_AGENT_MODEL=qwen2.5-coder:7b
CODER_AGENT_MODEL=qwen2.5-coder:7b
REVIEWER_AGENT_MODEL=qwen2.5-coder:7b
TESTER_AGENT_MODEL=qwen2.5-coder:7b
DEBUGGER_AGENT_MODEL=qwen2.5-coder:7b
MEMORY_AGENT_MODEL=qwen2.5-coder:7b
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096

# --- API ---
API_HOST=127.0.0.1
API_PORT=8000
API_BASE_PATH=/v1
API_AUTH_REQUIRED=false
# API_KEY=your-secret-key-here

# --- Agent ---
MAX_STEPS=30
MAX_RETRIES=3
MAX_TOOL_RETRIES=3
TOOL_COMMAND_TIMEOUT=120
CONTINUOUS_RUN=false
AUTO_GIT_COMMIT_ENABLED=true
GIT_USE_TEMP_BRANCH=false

# --- Mémoire vectorielle ---
EMBEDDING_MODEL=bge-m3
EMBEDDING_TIMEOUT=20
EMBEDDING_FALLBACK_ENABLED=true

# --- Hermes Memory (Qdrant ou local) ---
HERMES_MEMORY_ENABLED=true
HERMES_MEMORY_BACKEND=qdrant         # ou "local"
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=hermes_memory
HERMES_MEMORY_FILE=state/hermes_memory.json

# --- Obsidian ---
OBSIDIAN_VAULT_PATH=state/obsidian_vault
OBSIDIAN_DAILY_MEMORY_DIR=memories

# --- Chemins ---
PROJECT_ROOT=.
WORKSPACE_ROOT=.

# --- Logs ---
LOG_LEVEL=INFO
DEBUG=false
