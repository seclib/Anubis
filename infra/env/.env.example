# Copy to infra/env/.env for local deployment.
# Do not commit real secrets.

ANUBIS_ENV=development
ANUBIS_LOG_LEVEL=INFO

# Published host ports. Internal service names stay stable on the Docker network.
AI_CORE_PORT=8000
RAG_PORT=8001
TOOL_RUNNER_PORT=8002
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
REDIS_PORT=6379

# Production overlays use ranges so multiple replicas can bind host ports.
AI_CORE_PORT_RANGE=8000-8010
RAG_PORT_RANGE=8011-8020
TOOL_RUNNER_PORT_RANGE=8021-8030

# Internal service URLs.
ANUBIS_RAG_URL=http://rag-service:8001
ANUBIS_TOOL_RUNNER_URL=http://tool-runner:8002
ANUBIS_QDRANT_URL=http://qdrant:6333
ANUBIS_REDIS_URL=redis://redis:6379/0

# Persistence and logical names.
ANUBIS_QDRANT_COLLECTION=anubis_memory
ANUBIS_DATA_DIR=/var/lib/anubis
ANUBIS_ALLOWED_WORKSPACE=/workspace/sandbox
ANUBIS_AUDIT_LOG_PATH=/var/log/anubis/tool-audit.jsonl

# Runtime controls.
ANUBIS_LLM_PROVIDER=mock
ANUBIS_REQUEST_TIMEOUT_SECONDS=30
ANUBIS_WORKERS=2

# Future provider secrets.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
