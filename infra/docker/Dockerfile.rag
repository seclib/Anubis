# syntax=docker/dockerfile:1.7

FROM python:3.12-slim AS base
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1
WORKDIR /opt/anubis
RUN useradd --create-home --shell /usr/sbin/nologin anubis

COPY anubis/services/rag ./services/rag
RUN pip install --upgrade pip && pip install -e ./services/rag

RUN mkdir -p /var/lib/anubis \
    && chown -R anubis:anubis /var/lib/anubis /opt/anubis

USER anubis
EXPOSE 8001
HEALTHCHECK --interval=15s --timeout=3s --start-period=20s --retries=5 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8001/health', timeout=2).read()"

FROM base AS development
CMD ["uvicorn", "anubis_rag.main:create_app", "--factory", "--host", "0.0.0.0", "--port", "8001", "--reload"]

FROM base AS production
CMD ["sh", "-c", "uvicorn anubis_rag.main:create_app --factory --host 0.0.0.0 --port 8001 --workers ${ANUBIS_WORKERS:-2}"]
