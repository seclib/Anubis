# syntax=docker/dockerfile:1.7

FROM python:3.12-slim AS base
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1
WORKDIR /opt/anubis
RUN useradd --create-home --shell /usr/sbin/nologin toolrunner

COPY anubis/services/tools ./services/tools
RUN pip install --upgrade pip && pip install -e ./services/tools

RUN mkdir -p /workspace/sandbox /var/log/anubis \
    && chown -R toolrunner:toolrunner /workspace/sandbox /var/log/anubis /opt/anubis

USER toolrunner
EXPOSE 8002
HEALTHCHECK --interval=15s --timeout=3s --start-period=20s --retries=5 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8002/health', timeout=2).read()"

FROM base AS development
CMD ["uvicorn", "anubis_tools.runner:create_app", "--factory", "--host", "0.0.0.0", "--port", "8002", "--reload"]

FROM base AS production
CMD ["sh", "-c", "uvicorn anubis_tools.runner:create_app --factory --host 0.0.0.0 --port 8002 --workers ${ANUBIS_WORKERS:-2}"]
